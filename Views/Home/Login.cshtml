
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8" />
    <meta lang="vi" />
    <title>Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />
    <link rel="stylesheet" href="~/Content/style.css">
</head>
<body>
    <div class="login-page">
        <div class="login-box">
            <h2 class="login-title">Đăng nhập</h2>
            <form method="post" action="@Url.Action("Login", "Home")">
                <div class="form-group">
                    <label for="tenDangNhap">Tên đăng nhập</label>
                    <input type="text" id="tenDangNhap" name="tenDangNhap" placeholder="Nhập tên đăng nhập" required>
                </div>
                <div class="form-group">
                    <label for="matKhau">Mật khẩu</label>
                    <input type="password" id="matKhau" name="matKhau" placeholder="Nhập mật khẩu" required>
                </div>
                <button type="submit" class="btn-submit">Đăng nhập</button>
            </form>
        </div>
    </div>
</body>
</html>
