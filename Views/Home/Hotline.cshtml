
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8" />
    <meta lang="vi" />
    <title>Hotline</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />
    <link rel="stylesheet" href="~/Content/style.css">
</head>
<body>
    <div class="hotline-overlay" id="hotline-modal">
        <div class="hotline-modal" role="dialog" aria-modal="true" aria-labelledby="hotline-title">

            <div class="hotline-header">
                <h2 id="hotline-title">LIÊN HỆ HOTLINE ĐỂ NHẬN ĐƯỢC TƯ VẤN TỐT NHẤT</h2>
                <button class="hotline-close" type="button" aria-label="Đóng">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="hotline-body">
                <section class="hotline-box">
                    <div class="hotline-col">
                        <h3 class="hotline-title">HOÀNG HÀ PC HỒ CHÍ MINH</h3>
                        <ul class="hotline-list">
                            <li><i class="fa-solid fa-phone-volume ic"></i><a class="num" href="tel:0968123666">0968.123.666</a><span class="name">Mr. Bình</span></li>
                            <li><i class="fa-solid fa-phone-volume ic"></i><a class="num" href="tel:0379260260">0379.260.260</a><span class="name">Mr. Khanh</span></li>
                            <li><i class="fa-solid fa-phone-volume ic"></i><a class="num" href="tel:0359072072">0359.072.072</a><span class="name">Mr. Kiên</span></li>
                        </ul>
                    </div>
                    <div class="hotline-col">
                        <h4 class="hotline-sub hotline-sub--top">BẢO HÀNH - HỖ TRỢ KỸ THUẬT</h4>
                        <ul class="hotline-list">
                            <li><i class="fa-solid fa-phone-volume ic"></i><a class="num" href="tel:0345260260">0345.260.260</a><span class="name">Mr. Nhân</span></li>
                            <li><i class="fa-solid fa-phone-volume ic"></i><a class="num" href="tel:19006100">19006100</a><span class="name">Bảo hành</span></li>
                        </ul>
                    </div>
                </section>
            </div>
        </div>
    </div>
</body>
</html>
